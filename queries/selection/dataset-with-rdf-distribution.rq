PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>

CONSTRUCT {
    ?dataset a dcat:Dataset ;
        dct:title ?title ;
        dcat:distribution ?distribution .

    ?distribution a dcat:Distribution ;
        dcat:accessURL ?distribution_url ;
        dcat:mediaType ?distribution_mediaType ;
        dcat:compressFormat ?distribution_compressFormat ;
        dcat:byteSize ?distribution_size ;
        dct:conformsTo ?conformsTo ;
        dct:modified ?distribution_modified .
} WHERE {
    ?dataset a dcat:Dataset ;
        dct:title ?title ;
        dcat:distribution ?distribution ;
        schema:subjectOf ?registrationUrl .

    ?distribution dcat:accessURL ?distribution_url .
    OPTIONAL { ?distribution dcat:mediaType ?distribution_mediaType . }
    OPTIONAL { ?distribution dcat:compressFormat ?distribution_compressFormat . }
#    OPTIONAL { ?distribution dcat:byteSize ?distribution_size . }
    OPTIONAL { ?distribution dct:modified ?distribution_modified . }
    OPTIONAL { ?distribution dct:conformsTo ?conformsTo. }
    # The dataset register normalizes `+gzip`/`+zip` mediaType suffixes into a
    # separate dcat:compressFormat, so only the plain RDF mediaTypes need to
    # be listed here.
    FILTER(?conformsTo = <https://www.w3.org/TR/sparql11-protocol/>
        || ?distribution_mediaType = <https://www.iana.org/assignments/media-types/application/ld+json>
        || ?distribution_mediaType = <https://www.iana.org/assignments/media-types/application/n-quads>
        || ?distribution_mediaType = <https://www.iana.org/assignments/media-types/application/n-triples>
        || ?distribution_mediaType = <https://www.iana.org/assignments/media-types/application/rdf+xml>
        || ?distribution_mediaType = <https://www.iana.org/assignments/media-types/application/trig>
        || ?distribution_mediaType = <https://www.iana.org/assignments/media-types/text/turtle>
    )

    # Skip distributions that declare themselves an API we cannot read in full.
    # `dct:conformsTo` (which the register maps from `schema:usageInfo`) is used
    # for two different things: the access protocol of a distribution *and* the
    # content model a dump follows (EDM, SCHEMA-AP-NDE, Persons in Context).
    # Only the former disqualifies a distribution, so this is a blocklist of
    # access protocols rather than an allowlist of content models — an unknown
    # `conformsTo` is assumed to describe the content and is still analysed.
    #
    # Without this, an API that honestly serves `application/ld+json` — such as
    # the Rijksmuseum’s LDES, IIIF Change Discovery and Linked Art Search
    # endpoints — is parsed as if it were a dump, and its entry page alone is
    # published as the dataset’s summary.
    FILTER(NOT EXISTS {
        ?distribution dct:conformsTo ?apiSpecification .
        VALUES ?apiSpecification {
            <https://w3id.org/ldes/specification> # Remove once ldelements/lde#599 lands.
            <https://iiif.io/api/discovery/1.0/>
            <http://iiif.io/api/presentation/3/context.json>
            <https://linked.art/api/1.0/search/>
            <http://www.openarchives.org/pmh/>
            <https://www.openarchives.org/pmh/>
            <http://www.openarchives.org/OAI/openarchivesprotocol.html>
            <https://spec.openapis.org/oas/v3.2.0.html>
            <https://www.mediawiki.org/wiki/API:Tutorial>
            <https://www.ogc.org/standards/wms/>
            <https://www.openbeelden.nl/api/>
            <https://developers.soundcloud.com/docs/api/guide>
        }
    })

    # Exclude datasets whose registration source is gone (the registration URL
    # itself became unreachable). Datasets that merely failed description
    # validation (registry/invalid) are kept: their data distributions may still
    # be sound, and each distribution is validated at fetch time anyway. The
    # register marks both cases with schema:validUntil, so filter on the more
    # specific schema:additionalType to keep the invalid ones.
    FILTER(NOT EXISTS {
        ?registrationUrl schema:additionalType <https://data.netwerkdigitaalerfgoed.nl/registry/gone> .
    })

    # In case of a catalog, exclude datasets that are no longer part of the catalog.
    OPTIONAL {
        SELECT ?dataset (MAX(?datasetRead) AS ?datasetLastRead) (MAX(?registrationUrlRead) AS ?registrationUrlLastRead) {
            ?dataset schema:dateRead ?datasetRead ;
                schema:subjectOf ?registrationUrl .
            ?registrationUrl schema:dateRead ?registrationUrlRead .
        }
        GROUP BY ?dataset
    }
    FILTER(
        (!BOUND(?datasetLastRead) && !BOUND(?registrationUrlLastRead)) # Without Dataset Register metadata, for local tests.
        || ?datasetLastRead >= ?registrationUrlLastRead
    )

    # Exclude incremental updates download for dc4eu to get the snapshot download instead.
    FILTER(!STRSTARTS(STR(?distribution_url), "https://data.dc4eu.nl/updates/"))

    # Skip unreliable endpoints.
    FILTER(!STRSTARTS(STR(?distribution_url), "https://cat.apis.beeldengeluid.nl/sparql"))
} ORDER BY ?dataset ?distribution
